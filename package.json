{
  "name": "tinycorp",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "A desktop orchestrator where a Company is a team of AI Employees.",
  "author": "2yuri",
  "homepage": "https://github.com/2yuri/tinycorp",
  "desktopName": "tinycorp.desktop",
  "main": "out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --config electron-builder.config.mjs --publish never",
    "package:win": "electron-vite build && electron-builder --config electron-builder.config.mjs --win --publish never",
    "package:linux": "electron-vite build && electron-builder --config electron-builder.config.mjs --linux --publish never",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "knip": "knip --no-config-hints --no-gitignore",
    "test": "vitest run --project unit --project dom",
    "test:claude": "vitest run --project real",
    "test:e2e": "electron-vite build && playwright test",
    "test:coverage": "vitest run --project unit --project dom --coverage",
    "predev": "node tools/dev-identity.mjs",
    "provider:new": "node tools/provider-new.mjs",
    "design:baseline": "node tools/design-baseline.mjs",
    "design:compare": "node tools/design-baseline.mjs --compare",
    "bench:tokens": "node tools/bench/bench-tokens.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "5.0.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.0",
    "knip": "6.37.0",
    "lefthook": "2.1.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-hard-break": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.46.0",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "pixi.js": "^8.20.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smol-toml": "^1.9.0",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.6.5"
  }
}
